# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/supportpilot

# Security
SECRET_KEY=your-256-bit-secret-key-change-in-production-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-from-aistudio

# App
APP_NAME=SupportPilot
DEBUG=true
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Embeddings
EMBEDDING_DIMENSIONS=768
EMBEDDING_MODEL=text-embedding-004

# RAG
DEFAULT_TOP_K=5
MIN_SIMILARITY_THRESHOLD=0.7
CHUNK_SIZE=512
CHUNK_OVERLAP=64
